{
  "id": "grok-email-register",
  "name": "Grok 邮箱注册",
  "version": "1.3.1",
  "description": "真实 UI 注册：Electron 目录选择器选任意本地目录，主进程 fs 落盘账号；支持开始/停止/重置；worker 建箱收码。",
  "enabled": true,
  "permissions": [
    "browser-tab:message",
    "dialog",
    "fs",
    "http"
  ],
  "monitors": [
    {
      "id": "grok-register-bridge",
      "name": "Grok register bridge",
      "matches": [
        "*://accounts.x.ai/*",
        "*://*.x.ai/*",
        "*://grok.com/*",
        "*://*.grok.com/*"
      ],
      "events": [
        "dom:message"
      ]
    }
  ],
  "workers": [
    {
      "id": "mail",
      "entry": "worker/mail-worker.js"
    }
  ],
  "contentScripts": [
    {
      "id": "register-ui",
      "matches": [
        "*://accounts.x.ai/*",
        "*://*.x.ai/*",
        "*://grok.com/*",
        "*://*.grok.com/*"
      ],
      "js": [
        "content/register.js"
      ]
    }
  ]
}
