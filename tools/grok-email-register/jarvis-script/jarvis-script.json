{
  "id": "grok-email-register",
  "name": "Grok 邮箱注册",
  "version": "1.4.6",
  "description": "真实 UI 注册 + 脚本目录持久配置 + Electron 目录落盘(account/cpa/grok2api/sso) + OAuth(device-code + consent action=allow) + 可选 NSFW",
  "enabled": true,
  "permissions": [
    "browser-tab:message",
    "dialog",
    "fs",
    "http",
    "session"
  ],
  "monitors": [
    {
      "id": "grok-register-bridge",
      "name": "Grok register bridge",
      "matches": [
        "*://accounts.x.ai/*",
        "*://*.x.ai/*",
        "*://grok.com/*",
        "*://*.grok.com/*"
      ],
      "events": [
        "dom:message"
      ]
    }
  ],
  "workers": [
    {
      "id": "mail",
      "entry": "worker/mail-worker.js"
    }
  ],
  "contentScripts": [
    {
      "id": "register-ui",
      "matches": [
        "*://accounts.x.ai/*",
        "*://*.x.ai/*",
        "*://grok.com/*",
        "*://*.grok.com/*"
      ],
      "js": [
        "content/register.js"
      ]
    }
  ]
}
